flowchart TB
  subgraph app[namespace app]
    frontend[Frontend]
    gateway[Gateway]
    api[API]
    pg[(PostgreSQL)]
    redis[(Redis)]
  end

  subgraph sec[namespace security]
    vault[Vault HA]
    injector[Vault Agent Injector]
  end

  subgraph obs[namespace observability]
    prometheus[Prometheus]
    grafana[Grafana]
    loki[Loki]
    alloy[Alloy]
    blackbox[Blackbox exporter]
  end

  frontend -->|egress allow| gateway
  gateway -->|egress allow| api
  api -->|egress allow| pg
  api -->|egress allow| redis
  app -->|egress allow 8200| vault
  injector --> app
  prometheus -->|ServiceMonitor / scrape| app
  prometheus -->|kube-etcd scrape| etcd[(kubeadm etcd)]
  blackbox -->|HTTP/TCP probes| app
  alloy -->|Pod logs / events| loki
  grafana --> prometheus
  grafana --> loki
