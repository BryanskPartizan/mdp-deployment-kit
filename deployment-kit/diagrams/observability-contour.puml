@startuml
title Контур наблюдаемости
left to right direction
skinparam shadowing false

rectangle "Prometheus" as prom
rectangle "Grafana" as grafana
rectangle "Loki" as loki
rectangle "Alloy" as alloy
rectangle "Blackbox exporter" as blackbox
rectangle "Kubernetes metrics\nkube-state-metrics, node-exporter,\netcd scrape job" as k8s
rectangle "Application metrics\nAPI, Gateway, Frontend" as apps
rectangle "Datastores\nPostgreSQL, Redis exporters" as data
rectangle "GitLab / Vault endpoints" as platform

prom --> k8s
prom --> apps
prom --> data
blackbox --> apps
blackbox --> platform
alloy --> loki
grafana --> prom
grafana --> loki
@enduml
