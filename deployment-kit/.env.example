# Пример локальных переменных. Файл .env игнорируется git и не должен коммититься.
TF_VAR_yc_token=REPLACE_WITH_YC_IAM_TOKEN

# Для demo-стенда можно временно включить генерацию/использование небезопасных demo-секретов.
ALLOW_INSECURE_DEMO_SECRETS=false

# Platform secrets.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
GITLAB_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Domain/TLS profile. mdp — приватный домен стенда, поэтому по умолчанию используется self-signed issuer.
APP_DOMAIN=mdp
TLS_CLUSTER_ISSUER=test-selfsigned
# LETSENCRYPT_EMAIL нужен только для TLS_CLUSTER_ISSUER=letsencrypt-staging или letsencrypt-prod на публичном домене.
LETSENCRYPT_EMAIL=

# Application secrets.
POSTGRES_APP_USER=app
POSTGRES_DB=appdb
POSTGRES_APP_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Registry credentials. После запуска GitLab можно заменить на локальный registry.mdp.
REGISTRY_SERVER=registry.mdp
IMAGE_REGISTRY=registry.mdp
REGISTRY_USER=REPLACE_WITH_REGISTRY_USER
REGISTRY_PASSWORD=REPLACE_WITH_REGISTRY_TOKEN

# Vault app secrets передаются в Terraform как JSON.
TF_VAR_app_secret_overrides={"api":{"DATABASE_URL":"postgresql://app:REPLACE_WITH_STRONG_PASSWORD@postgres-postgresql.app.svc.cluster.local:5432/appdb","REDIS_URL":"redis://redis-master.app.svc.cluster.local:6379"},"gateway":{"API_BASE_URL":"http://api.app.svc.cluster.local:8081"},"frontend":{"GATEWAY_BASE_URL":"http://gateway.app.svc.cluster.local:8080"}}
