# Пример локальных переменных. Файл .env игнорируется git и не должен коммититься.
TF_VAR_yc_token=REPLACE_WITH_YC_IAM_TOKEN

# Для demo-стенда можно временно включить генерацию/использование небезопасных demo-секретов.
ALLOW_INSECURE_DEMO_SECRETS=false

# Platform secrets.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
GITLAB_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Ротация GitLab root secret выключена по умолчанию, чтобы повторный deploy не расходился с БД.
ROTATE_GITLAB_ROOT_PASSWORD=false

# Domain/TLS profile. Для публичного pkhco.ru используется только production Let's Encrypt.
APP_DOMAIN=pkhco.ru
TLS_CLUSTER_ISSUER=letsencrypt-prod
VAULT_HOST=vault.pkhco.ru
# LETSENCRYPT_EMAIL нужен для TLS_CLUSTER_ISSUER=letsencrypt-prod на публичном домене.
LETSENCRYPT_EMAIL=

# Публичная k8s-админка Headlamp выключена по умолчанию.
# Если включаете, задайте htpasswd-строку в одинарных кавычках:
#   htpasswd -nbB admin '<strong-password>'
K8S_ADMIN_ENABLED=false
K8S_ADMIN_BASIC_AUTH_HTPASSWD='REPLACE_WITH_HTPASSWD_LINE'

# Cloudflare DNS. Token должен иметь права Zone:Read и DNS:Edit для зоны pkhco.ru.
TF_VAR_cloudflare_zone_id=REPLACE_WITH_CLOUDFLARE_ZONE_ID
TF_VAR_cloudflare_api_token=REPLACE_WITH_CLOUDFLARE_DNS_TOKEN

# Application secrets.
POSTGRES_APP_USER=app
POSTGRES_DB=appdb
POSTGRES_APP_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Ротация PostgreSQL secret требует отдельной процедуры смены пароля в БД и Vault.
ROTATE_POSTGRES_SECRET=false

# Registry credentials. Для публичного стенда registry публикуется как registry.pkhco.ru.
REGISTRY_SERVER=registry.pkhco.ru
IMAGE_REGISTRY=registry.pkhco.ru
REGISTRY_USER=REPLACE_WITH_REGISTRY_USER
REGISTRY_PASSWORD=REPLACE_WITH_REGISTRY_TOKEN
# Production Let's Encrypt доверяется Docker без дополнительных insecure-настроек.
REGISTRY_TRUST_MODE=none

# Vault app secrets передаются в Terraform как JSON; одинарные кавычки защищают спецсимволы при source .env.
TF_VAR_app_secret_overrides='{"api":{"DATABASE_URL":"postgresql://app:REPLACE_WITH_STRONG_PASSWORD@postgres-postgresql.app.svc.cluster.local:5432/appdb","REDIS_URL":"redis://redis-master.app.svc.cluster.local:6379"},"gateway":{"API_BASE_URL":"http://api.app.svc.cluster.local:8081"},"frontend":{"GATEWAY_BASE_URL":"http://gateway.app.svc.cluster.local:8080"}}'

# Для app pipeline в GitLab используйте protected/masked variable, не локальный .env.
# KUBECONFIG_B64=base64-encoded-kubeconfig-with-minimal-deploy-rights
GITLAB_PROJECT_PATH=platform/deployment-kit
RUN_INFRA_PIPELINE=false
